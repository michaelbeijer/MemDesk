{
  "manifest_version": 3,
  "name": "MemDesk",
  "version": "0.28.1",
  "description": "A Kanban board, notes and your calendar inside Gmail. Every card is a Gmail thread, every note a message in your own mailbox.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://tasks.googleapis.com/*",
    "https://api.lemonsqueezy.com/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/mail/*"],
      "run_at": "document_idle",
      "js": [
        "src/shared/ns.js",
        "src/lib/util.js",
        "src/lib/board-logic.js",
        "src/lib/notes-logic.js",
        "src/lib/note-format.js",
        "src/lib/search-logic.js",
        "src/lib/calendar-logic.js",
        "src/lib/licence-logic.js",
        "src/content/gmail-hooks.js",
        "src/content/api.js",
        "src/content/store.js",
        "src/content/notes-store.js",
        "src/content/ui.js",
        "src/content/styles.js",
        "src/content/note-editor.js",
        "src/content/notes.js",
        "src/content/calendar-store.js",
        "src/content/calendar.js",
        "src/content/board.js",
        "src/content/dock.js",
        "src/content/main.js"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MemDesk",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-board": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open or close the board"
    }
  }
}
